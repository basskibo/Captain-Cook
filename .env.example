# PIN za otključavanje aplikacije
APP_PIN=1234

# Tajna za potpisivanje sesije (cookie). Generiši: openssl rand -hex 32
SESSION_SECRET=

# AI provajder: "gemini", "anthropic" ili "mock" (lažni recepti za lokalni test, bez ključa).
# Ako je prazno, bira se onaj čiji ključ postoji.
AI_PROVIDER=gemini

# Google Gemini (besplatan tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Anthropic Claude Haiku (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Prave fotografije jela (besplatno): https://www.pexels.com/api/
# Bez ključa se umesto slike prikazuje emoji.
PEXELS_API_KEY=
